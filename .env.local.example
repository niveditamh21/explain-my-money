# Explain My Money — Environment Variables

# Optional: Add your OpenAI API key for GPT-powered responses.
# Without it, the app uses a built-in rule-based AI that still gives great answers.
OPENAI_API_KEY=sk-...your-key-here

# Finbox API Credentials (for real bank data integration)
# Sign up at https://finbox.com to get these keys
NEXT_PUBLIC_FINBOX_CLIENT_ID=your_finbox_client_id_here
FINBOX_API_SECRET=your_finbox_api_secret_here
NEXT_PUBLIC_FINBOX_REDIRECT_URI=http://localhost:3000/api/finbox/callback
